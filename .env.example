# Copy to .env and adjust for your deployment.

NODE_ENV=production
PORT=3000

# Postgres connection string. In docker-compose this points at the `db` service.
DATABASE_URL=postgres://postgres:postgres@db:5432/open_artifacts

# Public origin this instance is served from (used for share links, device-flow verification_uri, CORS/CSP frame-ancestors).
APP_ORIGIN=http://localhost:3000

# Optional: serve artifact content (/embed/*) from a separate origin for stronger isolation.
# Leave unset to serve it from APP_ORIGIN's own /embed path (still opaque-origin-isolated via the iframe sandbox).
# ARTIFACT_ORIGIN=https://sandbox.example.com

# Random long string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Salt used when hashing viewer IPs for analytics (never store raw IPs).
IP_HASH_SALT=change-me-too

# First-run bootstrap account. If set and no such user exists yet, it is created as superadmin on startup.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-please

# Default TTL (days) for newly issued agent API keys, when the caller doesn't specify one. 0 = never expires.
DEFAULT_KEY_TTL_DAYS=90

# Who may self-register: open | invite_only | closed
DEFAULT_REGISTRATION_MODE=invite_only

# How often (minutes) the retention sweeper hard-deletes expired artifacts. 0 disables the
# background sweep — lifetimes still apply on read, they just never get physically reclaimed.
# The maximum/default artifact lifetime itself is set at runtime, in the admin settings.
ARTIFACT_PURGE_INTERVAL_MINUTES=5

# --- Object storage for uploaded artifact files (images/attachments) ---
# Leave S3_BUCKET unset to disable the feature entirely: upload endpoints answer 501, and an
# existing instance keeps working with zero changes. docker-compose.yml already sets these to
# point at its own bundled MinIO service by default — only edit them here to use an external
# S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, ...) instead, and drop the
# `minio` service from docker-compose.yml if you do. The bucket is created automatically on
# startup if it doesn't already exist.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=open-artifacts
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# MinIO and most self-hosted S3-compatibles need path-style URLs; real AWS S3 does not.
# S3_FORCE_PATH_STYLE=true

# Hard per-file upload cap in bytes, enforced before anything is written to storage — independent
# of the team/artifact byte quotas, which are set at runtime in the admin settings.
STORAGE_MAX_FILE_BYTES=26214400

# How often (minutes) the storage GC sweeper deletes objects queued for removal (a file's own
# artifact was deleted, expired, or the file was removed directly). 0 disables it — queued rows
# just accumulate until it's turned back on; nothing is served from them regardless.
STORAGE_GC_INTERVAL_MINUTES=5
