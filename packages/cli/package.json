{
  "name": "@emaxe/oa",
  "version": "0.6.1",
  "description": "CLI for Open Artifacts — publish HTML/Markdown/Mermaid/SVG content to a self-hosted artifact host and get back a shareable link.",
  "keywords": [
    "ai-agents",
    "artifacts",
    "claude-artifacts",
    "claude",
    "mcp",
    "model-context-protocol",
    "self-hosted",
    "cli",
    "open-artifacts",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "emaxe",
  "homepage": "https://github.com/emaxe/open-artifacts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxe/open-artifacts.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/emaxe/open-artifacts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "CHANGELOG.ru.md",
    "LICENSE"
  ],
  "bin": {
    "oa": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
