{
  "name": "open-artifacts",
  "private": true,
  "version": "0.11.0",
  "packageManager": "pnpm@11.1.2",
  "keywords": [
    "ai-agents",
    "artifacts",
    "claude-artifacts",
    "claude",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "self-hosted",
    "docker",
    "hono",
    "react",
    "typescript",
    "developer-tools",
    "open-artifacts",
    "llm",
    "s3",
    "constructor",
    "yaml",
    "block-builder",
    "report-generator"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:api": "pnpm --filter @open-artifacts/api dev",
    "dev:web": "pnpm --filter @open-artifacts/web dev",
    "dev:landing": "pnpm --filter @open-artifacts/landing dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @open-artifacts/api db:generate",
    "db:migrate": "pnpm --filter @open-artifacts/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
